# Optional. The easiest way to connect is the in-app Setup page (http://localhost:3000/setup).
# Anything set here overrides what was entered in the app. Copy to .env.local to use.

# --- Muse Wonder (required) ---------------------------------------------------
# Meta Model API key: dev.meta.ai -> API keys
MODEL_API_KEY=

# --- HeyReach (required) ------------------------------------------------------
# HeyReach -> Settings -> Integrations -> API
HEYREACH_API_KEY=
# Secret token in the webhook URL (the Setup page can generate one):
#   https://<your-tunnel>/api/webhooks/heyreach?token=<this value>
HEYREACH_WEBHOOK_TOKEN=

# --- Safety ---------------------------------------------------------------------
# Leave empty to control live mode from the Setup page. 0 = force off, 1 = force on.
RG_LIVE_ENABLED=
# Password for the whole UI (any username). Set this before exposing the app via a tunnel.
APP_PASSWORD=

# --- Advanced -------------------------------------------------------------------
MUSE_BASE_URL=https://api.meta.ai/v1
MUSE_MODEL=muse-wonder-1.0
# 0 = no background jobs (use the "Run now" buttons instead)
RG_JOBS_ENABLED=1
